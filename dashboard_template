# ──────────────────────────────────────────────────────────────────────────────
# Bentel Absoluta — Home Assistant Dashboard Template
#
# Replace all placeholder entity IDs with your actual ones.
# Entity IDs can be found in Settings → Devices & Services → MQTT → your device,
# or in Developer Tools → States filtered by "absoluta_panel".
#
# Required HACS custom cards:
#   - card-mod          (styling)
#   - auto-entities     (active sensors / bypassed zones cards)
#   - fold-entity-row   (collapsible partition rows)
#   - multiple-entity-row (zone rows with inline bypass toggle)
# ──────────────────────────────────────────────────────────────────────────────

# ── 1. PANEL FAULTS & ALARM MEMORY (conditional — shown only when active) ────
- type: conditional
  conditions:
    - condition: state
      entity: sensor.absoluta_panel_panel_faults
      state_not: No Problems
    - condition: state
      entity: sensor.absoluta_panel_panel_faults
      state_not: unavailable
  card:
    type: horizontal-stack
    cards:
      - type: markdown
        title: Alarm System Alarms
        content: >-
          {% set faults =
          state_attr('sensor.absoluta_panel_panel_faults',
          'faults') | default([], true) %}
          {% set alarms =
          state_attr('sensor.absoluta_panel_panel_faults',
          'alarms_in_memory') | default([], true) %}
          {% for g in faults %} - **{{ g.Time }}** — {{ g.Message }}
          {% endfor %}
          {% for a in alarms %} - **{{ a.Time }}** — {{ a.Message }} *(memory)*
          {% endfor %}
        card_mod:
          style: |
            ha-card {
              background: transparent !important;
              box-shadow: none !important;
              border: none !important;
            }
      - type: button
        entity: button.absoluta_panel_reset_alarm_memory
        icon: mdi:delete-sweep
        show_name: false
        show_state: false
        tap_action:
          action: perform-action
          perform_action: button.press
          target:
            entity_id: button.absoluta_panel_reset_alarm_memory
          confirmation: true
        card_mod:
          style: |
            :host {
              flex: 0 0 5rem !important;
              align-self: flex-start !important;
              margin-top: 1rem !important;
            }
            ha-card {
              background: transparent !important;
              box-shadow: none !important;
              border: none !important;
            }
    card_mod:
      style: |
        :host {
          background: var(--ha-card-background, white);
          border-radius: var(--ha-card-border-radius, 12px);
          box-shadow: var(--ha-card-box-shadow, 0 2px 2px rgba(0,0,0,.14));
          border: var(--ha-card-border-width, 1px) solid var(--ha-card-border-color, transparent);
          overflow: hidden;
        }

# ── 2. BRIDGE ALERTS (conditional — shown only when active) ──────────────────
- type: conditional
  conditions:
    - condition: state
      entity: sensor.absoluta_panel_bridge_alerts
      state: Warning!
  card:
    type: horizontal-stack
    cards:
      - type: markdown
        title: Bridge Alerts
        content: >-
          {% set alerts =
          state_attr('sensor.absoluta_panel_bridge_alerts', 'alerts') |
          default([], true) %}
          {% for alert in alerts | reverse %} - **{{ alert.Time }}** — {{ alert.Message }}
          {% endfor %}
        card_mod:
          style: |
            ha-card {
              background: transparent !important;
              box-shadow: none !important;
              border: none !important;
            }
      - type: button
        entity: button.absoluta_panel_reset_bridge_alerts
        icon: mdi:delete-sweep
        show_name: false
        show_state: false
        tap_action:
          action: perform-action
          perform_action: button.press
          target:
            entity_id: button.absoluta_panel_reset_bridge_alerts
          confirmation: true
        card_mod:
          style: |
            :host {
              flex: 0 0 5rem !important;
              align-self: flex-start !important;
              margin-top: 1rem !important;
            }
            ha-card {
              background: transparent !important;
              box-shadow: none !important;
              border: none !important;
            }
    card_mod:
      style: |
        :host {
          background: var(--ha-card-background, white);
          border-radius: var(--ha-card-border-radius, 12px);
          box-shadow: var(--ha-card-box-shadow, 0 2px 2px rgba(0,0,0,.14));
          border: var(--ha-card-border-width, 1px) solid var(--ha-card-border-color, transparent);
          overflow: hidden;
        }

# ── 3. GLOBAL ALARM PANEL ─────────────────────────────────────────────────────
- states:
    - arm_away
  type: alarm-panel
  entity: alarm_control_panel.absoluta_panel_global

# ── 4. ARMING MODE BUTTONS ────────────────────────────────────────────────────
- type: horizontal-stack
  cards:
    - show_name: true
      show_icon: true
      type: button
      tap_action:
        action: perform-action
        perform_action: button.press
        target:
          entity_id: button.absoluta_panel_mode_a
      icon_height: 50px
      entity: button.absoluta_panel_mode_a
      show_state: false
    - show_name: true
      show_icon: true
      type: button
      tap_action:
        action: perform-action
        perform_action: button.press
        target:
          entity_id: button.absoluta_panel_mode_b
      icon_height: 50px
      entity: button.absoluta_panel_mode_b
      show_state: false
    - show_name: true
      show_icon: true
      type: button
      tap_action:
        action: perform-action
        perform_action: button.press
        target:
          entity_id: button.absoluta_panel_mode_c
      icon_height: 50px
      entity: button.absoluta_panel_mode_c
      show_state: false
    - show_name: true
      show_icon: true
      type: button
      tap_action:
        action: perform-action
        perform_action: button.press
        target:
          entity_id: button.absoluta_panel_mode_d
      icon_height: 50px
      entity: button.absoluta_panel_mode_d
      show_state: false

# ── 5. ACTIVE SENSORS (auto-entities) ────────────────────────────────────────
# Shows only zones that are currently open/triggered. Hidden when all clear.
- type: custom:auto-entities
  card:
    type: entities
    title: Active Alarm Zones
  filter:
    include:
      - entity_id: binary_sensor.absoluta_panel_*
        state: 'on'
    exclude: []
  show_empty: false

# ── 6. BYPASSED ZONES (auto-entities) ────────────────────────────────────────
# Shows only zones that are currently bypassed. Hidden when none bypassed.
- type: custom:auto-entities
  card:
    type: entities
    title: Bypassed Alarm Zones
    show_header_toggle: false
  filter:
    include:
      - entity_id: switch.absoluta_panel_*_bypass
        state: 'on'
    exclude: []
  show_empty: false

# ── 7. PARTITIONS WITH ZONES (fold-entity-row) ───────────────────────────────
# Each partition is a collapsible row. Inside each partition, zones are listed
# with an inline bypass toggle. Duplicate the fold-entity-row blocks as needed.
- type: vertical-stack
  cards:
    - type: entities
      entities:

        # ── Partition 1 ──────────────────────────────────────────────────────
        - type: custom:fold-entity-row
          style:
            .: |
              div#head {
                --toggle-icon-width: 24px;
              }
          head:
            type: custom:multiple-entity-row
            entity: alarm_control_panel.absoluta_panel_partition_1  # REPLACE
          entities:
            - entity: binary_sensor.absoluta_panel_zone_1            # REPLACE
              type: custom:multiple-entity-row
              show_state: false
              state_color: true
              entities:
                - entity: switch.absoluta_panel_zone_1_bypass         # REPLACE
                  name: Bypass
                  toggle: true
            - entity: binary_sensor.absoluta_panel_zone_2            # REPLACE
              type: custom:multiple-entity-row
              show_state: false
              state_color: true
              entities:
                - entity: switch.absoluta_panel_zone_2_bypass         # REPLACE
                  name: Bypass
                  toggle: true

        # ── Partition 2 ──────────────────────────────────────────────────────
        - type: custom:fold-entity-row
          style:
            .: |
              div#head {
                --toggle-icon-width: 24px;
              }
          head:
            type: custom:multiple-entity-row
            entity: alarm_control_panel.absoluta_panel_partition_2  # REPLACE
          entities:
            - entity: binary_sensor.absoluta_panel_zone_3            # REPLACE
              type: custom:multiple-entity-row
              show_state: false
              state_color: true
              entities:
                - entity: switch.absoluta_panel_zone_3_bypass         # REPLACE
                  name: Bypass
                  toggle: true
            - entity: binary_sensor.absoluta_panel_zone_4            # REPLACE
              type: custom:multiple-entity-row
              show_state: false
              state_color: true
              entities:
                - entity: switch.absoluta_panel_zone_4_bypass         # REPLACE
                  name: Bypass
                  toggle: true
